    color: var(--mint-40) !important;
    background: rgb(from var(--mint-50) r g b / 0.15) !important;
  }
  .eui_tag.filled.eui_tag_disabled {
    color: var(--gray-30) !important;
    background: rgb(from var(--gray-30) r g b / 0.15) !important;
  }
  .eui_tag.filled.eui_tag_green {
    color: var(--mint-40) !important;
    background: rgb(from var(--green-40) r g b / 0.15) !important;
  }
  .eui_tag.filled.eui_tag_rose {
    color: var(--rose-30) !important;
    background: rgb(from var(--rose-30) r g b / 0.15) !important;
  }
  .eui_tag.filled.eui_tag_pink {
    color: var(--pink-30) !important;
    background: rgb(from var(--pink-30) r g b / 0.15) !important;
  }
  .eui_tag.filled.eui_tag_purple {
    color: var(--purple-30) !important;
    background: rgb(from var(--purple-30) r g b / 0.15) !important;
  }
  .eui_tag.filled.eui_tag_indigo {
    color: var(--indigo-30) !important;
    background: rgb(from var(--indigo-30) r g b / 0.15) !important;
  }
  .eui_tag.filled.eui_tag_cyan {
    color: var(--cyan-40) !important;
    background: rgb(from var(--cyan-50) r g b / 0.15) !important;
  }
}

// src/styles/hui-base.css
:root {
  /* 品牌色 */
  --color-brand: var(--brand-50);
  --color-brand-hover: var(--brand-40);
  --color-brand-focus: var(--brand-50);
  --color-brand-active: var(--brand-60);
  --color-brand-disabled: var(--brand-20);
  /* 文本色 */
  --color-text-primary: var(--gray-90);
  --color-text-secondary: var(--gray-50);
  --color-text-placeholder: var(--gray-30);
  --color-text-disabled: var(--gray-20);
  --color-text-inverse: var(--gray-0);
  --color-text-inverse-disabled: var(--gray-0);
  --color-text-on: var(--brand-50);
  --color-link: var(--brand-50);
  --color-link-hover: var(--brand-40);
  --color-link-active: var(--brand-60);
  --color-link-visited: var(--indigo-50);
  --color-link-disabled: var(--brand-20);
  /* 背景色 */
  --color-bg-1: var(--gray-05);
  --color-bg-2: var(--gray-0);
  --color-bg-3: var(--gray-0);
  --color-bg-4: var(--gray-0);
  --color-bg-5: var(--gray-0);
  --color-bg-6: rgb(from var(--gray-20) r g b / 0.2);
  --color-bg-mask: rgb(from var(--gray-90) r g b / 0.3);
  /* 填充色 */
  --color-fill-disabled: var(--gray-10);
  --color-hover: rgb(from var(--gray-90) r g b / 0.05);
  --color-fill-disabled-subtle: rgb(from var(--gray-90) r g b / 0.05);
  --color-fill: rgb(from var(--gray-90) r g b / 0.05);
  --color-select: var(--brand-05);
  --color-fill-subtle: var(--gray-0);

  /* 图标色 */
  --color-icon-primary: var(--gray-90);
  --color-icon-secondary: var(--gray-50);
  --color-icon-tertiary: var(--gray-40);
  --color-icon-placeholder: var(--gray-30);
  --color-icon-disabled: var(--gray-20);
  --color-icon-inverse: var(--gray-0);
  --color-icon-hover: var(--brand-40);
  --color-icon-focus: var(--brand-50);
  --color-icon-active: var(--brand-60);
  /* 边框色 */
  --color-border: var(--gray-20);
  --color-border-hover: var(--gray-90);
  --color-border-focus: var(--brand-50);
  --color-border-active: var(--brand-10);
  --color-border-disabled: var(--gray-20);
  --color-border-separator: var(--gray-10);
  --color-border-separator-sbutle: var(--gray-05);
  /* 功能色-错误 */
  --color-error: var(--red-50);
  --color-error-hover: var(--red-40);
  --color-error-active: var(--red-60);
  --color-error-disabled: var(--red-10);
  --color-error-subtle: var(--red-20);
  --color-error-subtler: var(--red-05);
  /* 功能色-告警 */
  --color-alert: var(--orange-50);
  --color-alert-hover: var(--orange-40);
  --color-alert-active: var(--orange-60);
  --color-alert-disabled: var(--orange-10);
  --color-alert-subtle: var(--orange-20);
  --color-alert-subtler: var(--orange-05);
  /* 功能色-提醒 */
  --color-warning: var(--yellow-50);
  --color-warning-hover: var(--yellow-40);
  --color-warning-active: var(--yellow-60);
  --color-warning-disabled: var(--yellow-10);
  --color-warning-bold: var(--yellow-60);
  --color-warning-subtle: var(--yellow-20);
  --color-warning-subtler: var(--yellow-05);
  /* 功能色-成功 */
  --color-success: var(--mint-50);
  --color-success-hover: var(--mint-40);
  --color-success-active: var(--mint-60);
  --color-success-disabled: var(--mint-10);
  --color-success-subtle: var(--mint-20);
