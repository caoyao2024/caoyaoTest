              销售价格（元）
            </span>
            <Spinner id="pageProductEditFormPriceInput" onChange={(val) => setInputNumberValuePageProductEditFormPriceInput(val)} value={inputNumberValuePageProductEditFormPriceInput} min={0} step={0.01} className={styles.pageProductEditFormPriceInput} />
          </div>
          <div id="pageProductEditFormStock" className={styles.pageProductEditFormStock}>
            <span id="pageProductEditFormStockLabel" className={styles.pageProductEditFormStockLabel}>
              库存数量
            </span>
            <Spinner id="pageProductEditFormStockInput" onChange={(val) => setInputNumberValuePageProductEditFormStockInput(val)} value={inputNumberValuePageProductEditFormStockInput} min={0} step={1} className={styles.pageProductEditFormStockInput} />
          </div>
          <div id="pageProductEditFormStatus" className={styles.pageProductEditFormStatus}>
            <span id="pageProductEditFormStatusLabel" className={styles.pageProductEditFormStatusLabel}>
              商品状态
            </span>
            <Select id="pageProductEditFormStatusSelect" onChange={(val) => setSelectValuePageProductEditFormStatusSelect(val)} value={selectValuePageProductEditFormStatusSelect} options={[{ value: "active", text: "上架" }, { value: "inactive", text: "下架" }]} defaultLabel={"请选择状态"} className={styles.pageProductEditFormStatusSelect} />
          </div>
          <div id="pageProductEditFormDesc" className={styles.pageProductEditFormDesc}>
            <span id="pageProductEditFormDescLabel" className={styles.pageProductEditFormDescLabel}>
              商品描述
            </span>
            <TextArea id="pageProductEditFormDescInput" onChange={(val) => setTextAreaValuePageProductEditFormDescInput(val)} value={textAreaValuePageProductEditFormDescInput} placeholder={"请输入商品描述信息"} className={styles.pageProductEditFormDescInput} />
          </div>
        </div>
      </Drawer>
      <Dialog id="pageProductDeleteModal" onClose={() => setModalIsOpenPageProductDeleteModal(false)} isOpen={modalIsOpenPageProductDeleteModal} modal={true} title={"确认删除"}>
        <span id="pageProductDeleteBody" className={styles.pageProductDeleteBody}>
          确定要删除该商品吗？删除后不可恢复。
        </span>
        <div id="pageProductDeleteFooter" className={styles.pageProductDeleteFooter}>
          <Button id="pageProductDeleteCancel" text={"取消"} onClick={() => setSharedState('isDeleteModalOpen', false)} />
          <Button id="pageProductDeleteConfirm" text={"确认删除"} status={"risk"} onClick={() => setSharedState('isDeleteModalOpen', false)} />
        </div>
      </Dialog>
    </div>
  )
}


