    <ThemeProvider>
      <RouterProvider router={router} />
    </ThemeProvider>
);


// src/shared/Badge.tsx
/**
 * Badge 公共组件（eview-ui shared）
 *
 * eview-ui 无 Badge 组件，此处手动实现对齐 eview-react Badge 接口（md/eview-react/Badge.md）。
 * 映射层（api/config/mappings/eview-react/Badge.ts 工厂，eview-ui 复用）产出的 props：
 * content / max / status / badgeStyle / dot / offset / showZero / className / children。
 *
 * import: import Badge from '@/shared/Badge'
 */

import React from 'react'

type BadgeStatus = 'default' | 'success' | 'error' | 'warning' | 'off'

export interface BadgeProps {
  /** 徽标内容：number / string / ReactNode；为 null/undefined/'' 时不显示 */
  content?: React.ReactNode | number
  /** 最大值，超过显示 {max}+（仅 content 为数字时有效），默认 99 */
  max?: number
  /** 不展示数字，只显示小红点 */
  dot?: boolean
  /** 状态点模式（配合 text 显示状态点及文本） */
  status?: BadgeStatus
  /** 状态点文本（设置 status 后有效） */
  text?: React.ReactNode
  /** 徽标偏移量 [水平, 垂直] */
  offset?: [number, number]
  /** 数值为 0 时是否展示 */
  showZero?: boolean
  /** 徽标自定义样式 */
  badgeStyle?: React.CSSProperties
  /** 徽标自定义类名 */
  badgeClassName?: string
  className?: string
  style?: React.CSSProperties
  id?: string
  /** 包裹的目标元素 */
  children?: React.ReactNode
}

const STATUS_COLOR: Record<BadgeStatus, string> = {
  default: '#8a8a8a',
  success: '#52c41a',
  error: '#ff4d4f',
  warning: '#faad14',
  off: '#d9d9d9',
}

export default function Badge(props: BadgeProps) {
  const {
    content, max = 99, dot, status, text, offset, showZero,
    badgeStyle, badgeClassName, className, style, id, children,
  } = props

  // ─── 状态点模式：dot + text ───
  if (status) {
    return (
      <span
        id={id}
        className={className}
        style={{ display: 'inline-flex', alignItems: 'center', gap: 6, ...style }}
      >
        <span
          className={badgeClassName}
          style={{
            width: 6, height: 6, borderRadius: '50%',
            background: STATUS_COLOR[status] ?? STATUS_COLOR.default,
            ...badgeStyle,
          }}
        />
        {text != null && <span>{text}</span>}
      </span>
    )
  }

  // ─── 数字 / 内容徽标 ───
  const isNum = typeof content === 'number'
  let display: React.ReactNode = null
  if (dot) {
    display = '' // 只显示红点
  } else if (content == null || content === '') {
    display = null
  } else if (isNum) {
    if (content === 0 && !showZero) {
      display = null
    } else if (content > max) {
      display = `${max}+`
    } else {
      display = content
    }
  } else {
    display = content
  }

  const showBadge = dot || display != null

  const badgeCss: React.CSSProperties = {
    position: 'absolute',
    top: 0,
    right: 0,
    transform: 'translate(50%, -50%)',
    minWidth: 16,
    height: 16,
    padding: '0 4px',
    borderRadius: 8,
    background: '#ff4d4f',
    color: '#fff',
    fontSize: 10,
    lineHeight: '16px',
    textAlign: 'center',
    boxSizing: 'border-box',
    whiteSpace: 'nowrap',
    ...(dot ? { width: 6, height: 6, minWidth: 0, padding: 0, borderRadius: '50%' } : {}),
    ...(offset ? { top: offset[1], right: offset[0] } : {}),
    ...badgeStyle,
  }

  return (
    <span
      id={id}
      className={className}
      style={{ position: 'relative', display: 'inline-block', ...style }}
    >
      {children}
      {showBadge && (
        <sup className={badgeClassName} style={badgeCss}>
          {dot ? '' : display}
        </sup>
      )}
    </span>
  )
}


// src/shared/Chart.tsx
/**
 * Chart 公共组件（eview-ui shared）
 *
 * eview-ui 无 Chart 组件，此处手动实现对齐 eview-react Chart 接口，内部用 @hui/charts（HuiCharts）渲染。
 * 映射层（api/config/mappings/eview-react/Chart.ts 工厂，eview-ui 复用）产出的 props：
 *   - name：图表类型字符串（LineChart / BarChart / PieChart / GaugeChart / RadarChart / ProcessChart / BubbleChart …）
 *     —— 即 A2UI 图表组件名，直接作为 HuiCharts 的 chartType
 *   - option：图表配置对象（含 a2:true、theme、数据等，由 buildChartOption 构建）
 *   - className / id
 *
 * HuiCharts 用法：
 *   const ins = new HuiCharts()
 *   ins.init(containerDom)
 *   ins.setSimpleOption(chartType, option)
 *   ins.render()
 *
 * import: import Chart from '@/shared/Chart'
 */

import React, { useEffect, useRef } from 'react'
// @ts-ignore — @hui/charts 来自 tgz，无类型声明
import HuiCharts from '@hui/charts'

export interface ChartProps {
  /** 图表类型（A2UI 图表组件名，作为 HuiCharts chartType） */
  name: string
  /** 图表配置对象 */
  option: Record<string, any>
  className?: string
  id?: string
  style?: React.CSSProperties
}

export default function Chart(props: ChartProps) {
  const { name, option, className, id, style } = props
  const containerRef = useRef<HTMLDivElement>(null)
  // HuiCharts 实例（无类型声明，用 any）
  const chartRef = useRef<any>(null)

  // 挂载：创建实例 + init（仅一次）
  useEffect(() => {
    const dom = containerRef.current
    if (!dom) return
    const ins = new HuiCharts()
    ins.init(dom)
    chartRef.current = ins
    return () => {
      // 卸载：释放（若库支持 dispose）
      const cur = chartRef.current
      if (cur) {
        try {
          cur.dispose?.()
        } catch {
          // ignore
        }
      }
      chartRef.current = null
    }
  }, [])

  // name / option 变化（含初始）：setSimpleOption + render
  useEffect(() => {
    const ins = chartRef.current
    if (!ins) return
    ins.setSimpleOption(name, option)
    ins.render()
  }, [name, option])

  return (
    <div
      id={id}
      className={className}
      ref={containerRef}
      // 图表容器需要明确尺寸：默认宽度 100%、高度 300px，可被 style/className 覆盖
      style={{ width: '100%', height: 300, ...style }}
    />
  )
}


// src/shared/Divider.tsx
/**
 * Divider 公共组件（eview-ui shared）
 *
 * eview-ui 无 Divider 组件，此处手动实现对齐 eview-react Divider 接口（md/eview-react/Divider.md）。
 * 映射层（api/config/mappings/eview-react/Divider.ts 工厂，eview-ui 复用）产出的 props：
 * type / dashed / orientation / className / children。
 *
 * import: import Divider from '@/shared/Divider'
 */

import React from 'react'

export interface DividerProps {
  /** 分割线方向：horizontal / vertical，默认 horizontal */
  type?: 'horizontal' | 'vertical'
  /** 是否虚线 */
  dashed?: boolean
  /** 标题位置（仅 children 有内容时生效）：left / right / center */
  orientation?: 'left' | 'right' | 'center'
  className?: string
  style?: React.CSSProperties
  id?: string
  /** 分割线标题内容（设置后中间显示文字） */
  children?: React.ReactNode
}

export default function Divider(props: DividerProps) {
  const {
    type = 'horizontal',
    dashed,
    orientation = 'center',
    className,
    style,
    id,
    children,
  } = props

  const borderStyle = dashed ? 'dashed' : 'solid'
  const lineColor = 'var(--color-border-separator)'

  // ─── 垂直分割线（行内） ───
  if (type === 'vertical') {
    return (
      <span
        id={id}
        className={className}
        style={{
          display: 'inline-block',
          width: 0,
          height: '1em',
          margin: '0 8px',
          borderLeft: `1px ${borderStyle} ${lineColor}`,
          verticalAlign: 'middle',
          ...style,
        }}
      />
    )
  }

  // ─── 水平分割线 ───
  const hasText = children != null
  const lineStyle: React.CSSProperties = {
    flex: 1,
    borderTop: `1px ${borderStyle} ${lineColor}`,
  }
  const textStyle: React.CSSProperties = { padding: '0 12px', color: 'inherit' }

  return (
    <div
      id={id}
      className={className}
      style={{ display: 'flex', alignItems: 'center', margin: '12px 0', ...style }}
    >
      {(orientation === 'right' || orientation === 'center') && <span style={lineStyle} />}
      {hasText && <span style={textStyle}>{children}</span>}
      {(orientation === 'left' || orientation === 'center') && <span style={lineStyle} />}
    </div>
  )
}


// src/shared/Empty.tsx
/**
 * Empty 公共组件（eview-ui shared）
 *
 * eview-ui 无 Empty 组件，此处手动实现对齐 eview-react Empty 接口（md/eview-react/Empty.md）。
 * 映射层（api/config/mappings/eview-react/Empty.ts 工厂，eview-ui 复用）产出的 props：
 * description / icon / imgSrc / className（type 不注入，走默认 fail）。
 *
 * 图标显示优先级：icon > imgSrc > 默认占位图（由 type 决定）。
 * 描述文本优先级：description > type 默认文本（fail→"暂无数据"，success→"数据为 0"）。
 *
 * import: import Empty from '@/shared/Empty'
 */

import React from 'react'

export interface EmptyProps {
  /** 描述文本，未设置时按 type 显示默认描述 */
  description?: React.ReactNode
  /** 自定义图标（优先级高于 imgSrc 与默认图标） */
  icon?: React.ReactNode
  /** 自定义图片 URL（优先级高于默认图标，低于 icon） */
  imgSrc?: string
  /** 预设空状态类型：fail 显示失败占位+"暂无数据"，success 显示成功占位+"数据为 0"，默认 fail */
  type?: 'success' | 'fail'
  className?: string
  style?: React.CSSProperties
  id?: string
}

// type → 默认描述文本
const DEFAULT_DESCRIPTION: Record<'success' | 'fail', string> = {
  fail: '暂无数据',
  success: '数据为 0',
}

// 默认占位图（type 区分）：简单内联 SVG，对齐 eview-react Empty 的"无数据/为零"语义
function DefaultImage({ type }: { type: 'success' | 'fail' }) {
  const stroke = type === 'success' ? 'var(--color-success, #52c41a)' : 'var(--color-text-disabled, #bfbfbf)'
  return (
    <svg width={64} height={41} viewBox="0 0 64 41" fill="none" aria-hidden>
      <ellipse cx={32} cy={33} rx={32} ry={8} fill={stroke} opacity={0.08} />
      <g stroke={stroke} strokeWidth={2} fill="none">
        <path d="M16 30V8a4 4 0 0 1 4-4h24a4 4 0 0 1 4 4v22" />
        <path d="M12 30h40" strokeLinecap="round" />
        <path d="M24 14h16M24 20h10" strokeLinecap="round" />
      </g>
    </svg>
  )
}

export default function Empty(props: EmptyProps) {
  const {
    description,
    icon,
    imgSrc,
    type = 'fail',
    className,
    style,
    id,
  } = props

  // 图标优先级：icon > imgSrc > 默认占位图
  const imageNode = icon ?? (imgSrc ? <img src={imgSrc} alt="" /> : <DefaultImage type={type} />)
  const descNode = description ?? DEFAULT_DESCRIPTION[type]

  return (
    <div
      id={id}
      className={className}
      style={{
        display: 'flex',
        flexDirection: 'column',
        alignItems: 'center',
        justifyContent: 'center',
        gap: 8,
        padding: '16px 0',
        color: 'var(--color-text-secondary, #8c8c8c)',
        fontSize: 14,
        ...style,
      }}
    >
      {imageNode}
      <span>{descNode}</span>
    </div>
  )
}


// src/shared/TableFilter.less
/* TableFilter 样式 */

.eui-custom-table-filter-wrapper {
    width: 296px;
    background-color: var(--color-bg-4);
    border-radius: var(--radius-base);

    .checkbox-wrapper {
        padding: var(--space-base);
        display: flex;
        flex-direction: column;
        gap: var(--space-base);
    }

    .checkbox-item-wrapper {
        padding-left: var(--space-2x);

        &:hover {
            border-radius: var(--radius-base);
            background-color: var(--color-fill-2);
        }
    }

    .button-wrapper {
        text-align: right;
        padding: var(--space-3x) 0;
    }
}


// src/shared/TableFilter.tsx
/**
 * TableFilter 公共组件（eview-ui shared）
 *
 * import: import TableFilter from '@/shared/TableFilter'
 */

import React, { useState, useCallback } from 'react'
import Checkbox from '@cloudsop/eview-ui/Checkbox'
import TextButton from '@cloudsop/eview-ui/TextButton'
import Divider from './Divider'
import './TableFilter.less'

export interface TableFilterOption {
  text: string
  value: string
}

export interface TableFilterProps {
  /** 过滤选项列表，每项 { text, value }，必填 */
  data: TableFilterOption[]
  /** 选中值变化回调，参数为当前选中的 value 数组 */
  onFilter?: (value: string[]) => void
}

export default function TableFilter(props: TableFilterProps) {
  const { data, onFilter } = props

  const [checkedValue, setCheckedValue] = useState<Set<string>>(new Set())

  const handleChange = useCallback((value: string, checked: boolean) => {
    const newSet = new Set([...checkedValue])
    if (checked) {
      newSet.add(value)
    } else {
      newSet.delete(value)
    }
    setCheckedValue(newSet)
  }, [checkedValue])

  const reset = useCallback(() => {
    setCheckedValue(new Set())
  }, [])

  if (!data.length) return null

  return (
    <div className="eui-custom-table-filter-wrapper">
      <div className="checkbox-wrapper">
        {data.map((item) => (
          <div className="checkbox-item-wrapper" key={item.value}>
            <Checkbox
              value={item.value}
              label={item.text}
              checked={checkedValue.has(item.value)}
              onChange={handleChange}
            />
          </div>
        ))}
      </div>
      <Divider style={{ margin: 'unset' }} />
      <div className="button-wrapper">
        <TextButton
          disabled={checkedValue.size === 0}
          onClick={reset}
          text="重置"
        />
        <TextButton
          style={{ padding: '0 var(--space-3x)' }}
          onClick={() => onFilter?.([...checkedValue])}
          text="筛选"
        />
      </div>
    </div>
  )
}


// src/styles/base.css
:root {
  /* ==========================================================================
     1. 基础色阶 (Primitive Colors)
     ========================================================================== */
  /* brand */
  --brand-05: #E6F2FD;
  --brand-10: #B8D9F9;
  --brand-20: #8ABEF3;
  --brand-30: #5CA2E9;
  --brand-40: #2E86DE;
  --brand-50: #0067D1;
  --brand-60: #004EA8;
  --brand-70: #003D83;
  --brand-80: #002E6A;
  --brand-90: #00214B;

  /* gray */
   --gray-0: #FFFFFF;
   --gray-05: #F3F3F3;
   --gray-10: #DFDFDF;
   --gray-20: #C9C9C9; 
   --gray-30: #AEAEAE;
   --gray-40: #939393;
   --gray-50: #777777;
   --gray-60: #595959;
   --gray-70: #393939;
   --gray-80: #2A2A2A;
   --gray-90: #191919;
   --gray-100: #000000;

   /* red */
   --red-05: #FEE7E8;
   --red-10: #FABDC1;
   --red-20: #F59297;
   --red-30: #EE696F;
   --red-40: #E7434A;
   --red-50: #E02128;
   --red-60: #C7000B;
   --red-70: #850F12;
   --red-80: #59080A;
   --red-90: #350305;

   /* rose */
   --rose-05: #FEE5F2;
   --rose-10: #FCC3E0;
   --rose-20: #F99AC7;
   --rose-30: #F470AB;
   --rose-40: #ED448A;
   --rose-50: #E61866;
   --rose-60: #C40054;
   --rose-70: #811439;
   --rose-80: #540D24;
   --rose-90: #330614;

   /* orange */
   --orange-05: #FEF5E8;
   --orange-10: #FDE2BD;
   --orange-20: #FCCE92;
   --orange-30: #F9B766;
   --orange-40: #F69E39;
   --orange-50: #F4840C;
   --orange-60: #C76207;
   --orange-70: #954304;
   --orange-80: #642802;
   --orange-90: #3D1601;

   /* yellow */
   --yellow-05: #FEFCE0;
   --yellow-10: #FEF8B8;
   --yellow-20: #FEF08A;
   --yellow-30: #FDE55C;
   --yellow-40: #FCD72E;
   --yellow-50: #FCC800;
   --yellow-60: #D19F00;
   --yellow-70: #9E7400;
   --yellow-80: #614500;
   --yellow-90: #2E1F00;

   /* green */
   --green-05: #F2FBE9;
   --green-10: #DFF4CC;
   --green-20: #C6E9A8;
   --green-30: #A8DB81;
   --green-40: #87C859;
   --green-50: #62B42E;
   --green-60: #488E20;
   --green-70: #316614;
   --green-80: #1B3E0A;
   --green-90: #0C2004;

   /* mint */
   --mint-05: #E7FBF2;
   --mint-10: #BCF2DB;
   --mint-20: #8FE5C2;
   --mint-30: #63D5A8;
   --mint-40: #36C18D;
   --mint-50: #09AA71;
   --mint-60: #058358;
   --mint-70: #036142;
   --mint-80: #02422E;
   --mint-90: #00291D;

   /* cyan */
   --cyan-05: #E8FCFD;
   --cyan-10: #C9F6F9;
   --cyan-20: #A4ECF1;
   --cyan-30: #7DDFE7;
   --cyan-40: #55CCD9;
   --cyan-50: #2CB8C9;
   --cyan-60: #1C94A4;
   --cyan-70: #127180;
   --cyan-80: #094C57;
   --cyan-90: #04282F;

   /* blue */
   --blue-05: #EEF3FE;
   --blue-10: #D0D8FD;
   --blue-20: #B0BFFD;
   --blue-30: #8CA3FA;
   --blue-40: #668CF7;
   --blue-50: #2070F3;
   --blue-60: #1F55B5;
   --blue-70: #1B3F86;
   --blue-80: #112857;
   --blue-90: #081635;

   /* indigo */
   --indigo-05: #EEEEFE;
   --indigo-10: #D5D3FD;
   --indigo-20: #BFB9FA;
   --indigo-30: #A89FF9;
   --indigo-40: #8E81F4;
   --indigo-50: #715AFB;
   --indigo-60: #5531EB;
   --indigo-70: #3F21B5;
   --indigo-80: #281675;
   --indigo-90: #160B48;

   /* purple */
   --purple-05: #F7EDFE;
   --purple-10: #E8CFFE;
   --purple-20: #D9B1FD;
   --purple-30: #CB8EFB;
   --purple-40: #BF68FA;
   --purple-50: #B62BF7;
   --purple-60: #8A21BC;
   --purple-70: #651B8B;
   --purple-80: #41125A;
   --purple-90: #260937;

   /* pink */
   --pink-05: #FDE6FC;
   --pink-10: #F9C5F6;
   --pink-20: #F39DEC;
   --pink-30: #EB74DF;
   --pink-40: #E049CE;
   --pink-50: #D41DBC;
   --pink-60: #9F1C8D;
   --pink-70: #751868;
   --pink-80: #4C0F43;
   --pink-90: #2E0728;



  /* ==========================================================================
     3. 尺寸与形状变量 (Sizes & Shapes)
     ========================================================================== */

  /* Radius */
  --radius-none: 0;
  --radius-xs: 2px;
  --radius-base: 4px;
  --radius-md: 6px;
  --radius-lg: 8px;
  --radius-xl: 12px;
  --radius-full: 999px;

  /* ==========================================================================
     4. 文本排版 (Typography)
     ========================================================================== */
  /* Font Family */
  --font-family: 'HarmonyOS Sans', 'Microsoft YaHei', Arial, 'PingFang SC', 'San Francisco', sans-serif;

  /* Font Size */
  --font-size-sm: 10px;
  --font-size-base: 12px;
  --font-size-md: 14px;
  --font-size-lg: 16px;
  --font-size-xl: 18px;
  --font-size-2xl: 20px;
  --font-size-3xl: 24px;
  --font-size-4xl: 28px;
  --font-size-5xl: 30px;
  --font-size-6xl: 32px;
  --font-size-7xl: 36px;
  --font-size-8xl: 40px;
  --font-size-12xl: 48px;
  --font-size-16xl: 56px;
  --font-size-18xl: 60px;
  --font-size-24xl: 72px;

  /* Line Height */
  --line-height-xs: 2;
  --line-height-sm: 1.625;
  --line-height-md: 1.5;
  --line-height-lg: 1.5;
  --line-height-xl: 1.5;
  --line-height-2xl: 1.375;
  --line-height-3xl: 1.375;
  --line-height-4xl: 1.375;
  --line-height-5xl: 1.375;
  --line-height-6xl: 1.375;
  --line-height-7xl: 1.25;
  --line-height-8xl: 1.25;
  --line-height-9xl: 1.25;

 

  /* Font Weight */
  --font-weight-light: 300;
  --font-weight-normal: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;


  /* ==========================================================================
     5. 间距 (Spacing)
     ========================================================================== */
  --spacing-0: 0px;
  --spacing-0-5: 0.125rem;
  --spacing-1: 0.25rem;
  --spacing-1-5: 0.375rem;
  --spacing-2: 0.5rem;
  --spacing-2-5: 0.625rem;
  --spacing-3: 0.75rem;
  --spacing-3-5: 0.875rem;
  --spacing-4: 1rem;
  --spacing-4-5: 1.125rem;
  --spacing-5: 1.25rem;
  --spacing-6: 1.5rem;
  --spacing-7: 1.75rem;
  --spacing-8: 2rem;
  --spacing-9: 2.25rem;
  --spacing-10: 2.5rem;
  --spacing-11: 2.75rem;
  --spacing-12: 3rem;
  --spacing-14: 3.5rem;
  --spacing-15: 3.75rem;
  --spacing-16: 4rem;
  --spacing-17: 4.25rem;
  --spacing-18: 4.5rem;
  --spacing-19: 4.75rem;
  --spacing-20: 5rem;
  --spacing-24: 6rem;
  --spacing-28: 7rem;
  --spacing-32: 8rem;
  --spacing-36: 9rem;
  --spacing-40: 10rem;
  --spacing-44: 11rem;
  --spacing-48: 12rem;
  --spacing-52: 13rem;
  --spacing-56: 14rem;
  --spacing-60: 15rem;
  --spacing-64: 16rem;
  --spacing-72: 18rem;
  --spacing-80: 20rem;
  --spacing-96: 24rem;
}

// src/styles/global.less
/* 全局样式 — 由 json-to-react 工具生成 */
* {
  margin: 0;
  padding: 0;
  border:0 solid;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  -webkit-font-smoothing: antialiased;
}

html {
  font-size: 16px;
}


// src/styles/hui-base-dark.css
body.theme-dark {
  /* 品牌色 */
  --color-brand: var(--brand-50);
  --color-brand-hover: var(--brand-40);
  --color-brand-focus: var(--brand-50);
  --color-brand-active: var(--brand-60);
  --color-brand-disabled: var(--brand-70);
  /* 文本色 */
  --color-text-primary: var(--gray-0);
  --color-text-secondary: var(--gray-20);
  --color-text-placeholder: var(--gray-40);
  --color-text-disabled: var(--gray-40);
  --color-text-inverse: var(--gray-0);
  --color-text-inverse-disabled: rgb(from var(--gray-05) r g b / 0.3);
  --color-text-on: var(--gray-0);
  --color-link: var(--brand-30);
  --color-link-hover: var(--brand-20);
  --color-link-active: var(--brand-40);
  --color-link-visited: var(--indigo-50);
  --color-link-disabled: var(--brand-60);
  /* 背景色 */
  --color-bg-1: var(--gray-100);
  --color-bg-2: var(--gray-90);
  --color-bg-3: var(--gray-80);
  --color-bg-4: var(--gray-70);
  --color-bg-5: rgb(from var(--gray-05) r g b / 0.1);
  --color-bg-6: rgb(from var(--gray-05) r g b / 0.1);
  --color-bg-mask: rgb(from var(--gray-0) r g b / 0.7);
  /* 填充色 */
  --color-fill-disabled: var(--gray-60);
  --color-hover: rgb(from var(--gray-05) r g b / 0.2);
  --color-fill-disabled-subtle: rgb(from var(--gray-05) r g b / 0.2);
  --color-fill: rgb(from var(--gray-05) r g b / 0.2);
  --color-select: rgb(from var(--brand-50) r g b / 0.4);
  --color-fill-subtle: rgb(from var(--gray-100) r g b / 0);

  /* 图标色 */
  --color-icon-primary: var(--gray-10);
  --color-icon-secondary: var(--gray-30);
  --color-icon-tertiary: var(--gray-50);
  --color-icon-placeholder: var(--gray-40);
  --color-icon-disabled: var(--gray-40);
  --color-icon-inverse: var(--gray-0);
  --color-icon-hover: var(--brand-20);
  --color-icon-focus: var(--brand-30);
  --color-icon-active: var(--brand-40);
  /* 边框色 */
  --color-border: var(--gray-50);
  --color-border-hover: var(--gray-05);
  --color-border-focus: var(--brand-40);
  --color-border-active: var(--brand-80);
  --color-border-disabled: var(--gray-60);
  --color-border-separator: rgb(from var(--gray-05) r g b / 0.15);
  --color-border-separator-sbutle: rgb(from var(--gray-05) r g b / 0.1);
  /* 功能色-错误 */
  --color-error: var(--red-40);
  --color-error-hover: var(--red-30);
  --color-error-active: var(--red-50);
  --color-error-disabled: var(--red-80);
  --color-error-subtle: var(--red-60);
  --color-error-subtler: var(--red-80);
  /* 功能色-告警 */
  --color-alert: var(--orange-50);
  --color-alert-hover: var(--orange-40);
  --color-alert-active: var(--orange-60);
  --color-alert-disabled: var(--orange-80);
  --color-alert-subtle: var(--orange-60);
  --color-alert-subtler: var(--orange-80);
  /* 功能色-提醒 */
  --color-warning: var(--yellow-40);
  --color-warning-hover: var(--yellow-30);
  --color-warning-active: var(--yellow-50);
  --color-warning-disabled: var(--yellow-80);
  --color-warning-bold: var(--yellow-60);
  --color-warning-subtle: var(--yellow-60);
  --color-warning-subtler: var(--yellow-80);
  /* 功能色-成功 */
  --color-success: var(--mint-60);
  --color-success-hover: var(--mint-50);
  --color-success-active: var(--mint-60);
  --color-success-disabled: var(--mint-80);
  --color-success-subtle: var(--mint-60);
  --color-success-subtler: var(--mint-80);
  /* 功能色-信息 */
  --color-info-primary: var(--blue-50);
  --color-info-primary-subtle: var(--blue-60);
  --color-info-primary-subtler: var(--blue-80);
  --color-info-secondary: var(--blue-60);
  --color-info-secondary-hover: var(--blue-40);
  --color-info-secondary-active: var(--blue-60);
  --color-info-secondary-disabled: var(--blue-80);
  --color-info-secondary-subtle: var(--blue-80);
  /* 功能色-失效 */
  --color-none: var(--gray-60);
  --color-none-hover: rgb(from var(--gray-05) r g b / 0.2);
  --color-none-active: var(--gray-50);
  --color-none-disabled: var(--gray-90);
  --color-none-subtle: var(--gray-90);
  /* 推荐图表色 */
  --color-chart-1: var(--blue-50);
  --color-chart-2: var(--green-50);
  --color-chart-3: var(--indigo-50);
  --color-chart-4: var(--cyan-50);
  --color-chart-5: var(--orange-40);
  --color-chart-6: var(--brand-30);
  --color-chart-7: var(--purple-60);
  --color-chart-8: var(--rose-60);
  --color-chart-9: var(--indigo-60);
  --color-chart-10: var(--yellow-60);
  --color-chart-11: var(--brand-60);
  --color-chart-12: var(--green-60);
  --color-chart-13: var(--purple-70);
  --color-chart-14: var(--cyan-60);
  --color-chart-15: var(--orange-70);
  --color-chart-16: var(--rose-60);
  --color-chart-17: var(--cyan-70);
  --color-chart-18: var(--blue-60);
  --color-chart-19: var(--green-70);
  --color-chart-20: var(--indigo-70);
  --color-chart-21: var(--rose-70);
  --color-chart-22: var(--cyan-30);
  --color-chart-23: var(--yellow-70);
  --color-chart-24: var(--purple-50);
  --color-chart-25: var(--mint-70);
  /* 特殊场景 */
  --color-scrollbar: var(--gray-60);
  --color-scrollbar-hover: var(--gray-40);
  --color-card-gray-disabled: rgb(from var(--gray-40) r g b / 0.05);
  --color-card-white-disabled: rgb(from var(--gray-40) r g b / 0.1);
  --color-sidenav-bg: var(--gray-70);
  --color-table-header: rgb(from var(--gray-05) r g b / 0.1);
  --color-table-zebra: rgb(from var(--gray-50) r g b / 0.15);
  --color-message-bg-info: rgb(from var(--blue-50) r g b / 0.15);
  --color-message-bg-success: rgb(from var(--mint-60) r g b / 0.15);
  --color-message-bg-warning: rgb(from var(--yellow-40) r g b / 0.15);
  --color-message-bg-alert: rgb(from var(--orange-50) r g b / 0.15);
  --color-message-bg-error: rgb(from var(--red-40) r g b / 0.15);

  /* ICT3.0 3.0告警色 */
  --color-alert-urgent: #F43146;
  --color-alert-primary: #EC6F1A;
  --color-alert-secondary: #EEBA18;
  --color-alert-success: #0D9458;
  --color-alert-running: #5990FD;
  --color-alert-none: #818181;
  /* ICT3.1 表格 */
  --color-table-1: rgb(from var(--brand-50) r g b / 0.2);
  --color-table-2: rgb(from var(--brand-50) r g b / 0.4);
  --color-table-sticky-1: var(--brand-80);
  --color-table-sticky-2: var(--brand-70);
  --color-table-sticky-bg: var(--gray-70);
  --color-table-sticky-header: var(--gray-70);
  /* 标签配色 */
  --color-tag-text-purple: var(--purple-30);
  --color-tag-bg-purple: rgb(from var(--purple-30) r g b / 0.15);
  --color-tag-text-cyan: var(--cyan-40);
  --color-tag-bg-cyan: rgb(from var(--cyan-50) r g b / 0.15);
  --color-tag-text-rose: var(--rose-30);
  --color-tag-bg-rose: rgb(from var(--rose-30) r g b / 0.15);
  --color-tag-text-green: var(--green-50);
  --color-tag-bg-green: rgb(from var(--green-40) r g b / 0.15);
  --color-tag-text-pink: var(--pink-30);
  --color-tag-bg-pink: rgb(from var(--pink-30) r g b / 0.15);
  --color-tag-text-indigo: var(--indigo-30);
  --color-tag-bg-indigo: rgb(from var(--indigo-30) r g b / 0.15);
  --color-tag-text-none: var(--gray-30);
  --color-tag-bg-none: rgb(from var(--gray-30) r g b / 0.15);
  --color-tag-text-error: var(--red-40);
  --color-tag-bg-error: rgb(from var(--red-30) r g b / 0.15);
  --color-tag-text-alert: var(--orange-40);
  --color-tag-bg-alert: rgb(from var(--orange-50) r g b / 0.15);
  --color-tag-text-warning: var(--yellow-50);
  --color-tag-bg-warning: rgb(from var(--yellow-30) r g b / 0.15);
  --color-tag-text-success: var(--mint-40);
  --color-tag-bg-success: rgb(from var(--mint-50) r g b / 0.15);
  --color-tag-text-info: var(--blue-30);
  --color-tag-bg-info: rgb(from var(--blue-40) r g b / 0.15);

  /* Border */
  --border: var(--gray-50);
  --border-light: rgb(from var(--gray-05) r g b / 0.15);
  --border-primary: var(--brand-30);
  --border-success: var(--mint-20);
  --border-warning: var(--yellow-20);
  --border-alert: var(--orange-20);
  --border-error: var(--red-20);

  /* Icon */
  --icon-primary: var(--brand-30);
  --icon-success: var(--mint-30);
  --icon-warning: var(--yellow-30);
  --icon-critical: var(--orange-30);
  --icon-alert: var(--orange-30);
  --icon-error: var(--red-30);


  /* Shadow (暗色模式下阴影更强) */
  --shadow-none: none;
  --shadow-sm: 0 1px 6px rgba(0, 0, 0, 0.5);
  --shadow-base: 0 4px 12px rgba(0, 0, 0, 0.5);
  --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.5);
  --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.5);
  --shadow-xl: 0 16px 48px rgba(0, 0, 0, 0.5);
  --shadow-r-sm: 1px 0 6px 0 rgba(0, 0, 0, 0.5);
  --shadow-t-sm: 0 -1px 6px rgba(0, 0, 0, 0.5);
  --shadow-l-base: -2px 0 12px 0 rgba(0, 0, 0, 0.5);
  --shadow-l-md: -2px 0 24px 0 rgba(0, 0, 0, 0.5);

  color: var(--color-text-primary);

  /* Tag solid 样式（暗色模式下 solid 背景保持不变） */
  .eui_tag.eui_tag_default {
    color: var(--gray-30) !important;
    background: rgb(from var(--gray-30) r g b / 0.15) !important;
  }
  .eui_tag.eui_tag_info {
    color: var(--gray-0) !important;
    background: var(--blue-50) !important;
  }
  .eui_tag.eui_tag_error {
    color: var(--gray-0) !important;
    background: var(--red-50) !important;
  }
  .eui_tag.eui_tag_alert {
    color: var(--gray-0) !important;
    background: var(--orange-50) !important;
  }
  .eui_tag.eui_tag_warning {
    color: var(--gray-0) !important;
    background: var(--yellow-50) !important;
  }
  .eui_tag.eui_tag_success {
    color: var(--gray-0) !important;
    background: var(--mint-50) !important;
  }
  .eui_tag.eui_tag_disabled {
    color: var(--gray-0) !important;
    background: var(--gray-30) !important;
  }
  .eui_tag.eui_tag_green {
    color: var(--gray-0) !important;
    background: var(--green-50) !important;
  }
  .eui_tag.eui_tag_rose {
    color: var(--gray-0) !important;
    background: var(--rose-50) !important;
  }
  .eui_tag.eui_tag_pink {
    color: var(--gray-0) !important;
    background: var(--pink-50) !important;
  }
  .eui_tag.eui_tag_purple {
    color: var(--gray-0) !important;
    background: var(--purple-50) !important;
  }
  .eui_tag.eui_tag_indigo {
    color: var(--gray-0) !important;
    background: var(--indigo-50) !important;
  }
  .eui_tag.eui_tag_cyan {
    color: var(--gray-0) !important;
    background: var(--cyan-50) !important;
  }

  /* Tag filled（outline/淡底）样式（暗色模式，对齐 eview-react hui-base-dark.css） */
  /* default 颜色不受 variant 影响，无 .eui_tag.filled.eui_tag_default */
  .eui_tag.filled.eui_tag_info {
    color: var(--brand-30) !important;
    background: rgb(from var(--brand-30) r g b / 0.15) !important;
  }
  .eui_tag.filled.eui_tag_error {
    color: var(--red-40) !important;
    background: rgb(from var(--red-30) r g b / 0.15) !important;
  }
  .eui_tag.filled.eui_tag_alert {
    color: var(--orange-40) !important;
    background: rgb(from var(--orange-50) r g b / 0.15) !important;
  }
  .eui_tag.filled.eui_tag_warning {
    color: var(--yellow-50) !important;
