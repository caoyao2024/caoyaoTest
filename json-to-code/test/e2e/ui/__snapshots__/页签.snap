        </span>
      )
    },
    allowSort: false
  },
  {
    key: "port",
    title: "端口",
    render: (cellValue, rowData, options, row) => {
      const { port } = row._org;
      return (
        <span id="drfPolCardPortCell" className={styles.drfPolCardPortCell}>
          {port}
        </span>
      )
    },
    allowSort: false
  },
  {
    key: "portDataButtonText",
    title: "端口数据",
