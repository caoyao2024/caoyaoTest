import { createBrowserRouter, Navigate } from 'react-router-dom';
import App from '../App';

import EventTestRootPage from '../pages/eventTestRoot';

const router = createBrowserRouter([
  {
    path: '/',
    element: <App />,
    children: [
      { index: true, element: <Navigate to="/eventTestRoot" replace /> },
      { path: 'eventTestRoot', element: <EventTestRootPage /> },
    ],
  },
]);

export default router;

// src/pages/eventTestRoot/state.ts
export const initialState = {
    isDetailOpen: false
  };

export default initialState;

// src/pages/eventTestRoot/shared-state.ts

import { useSyncExternalStore } from 'react' 
import { initialState } from './state'

function createSharedStore(init: Record<string, any>) {
  let state = init
  const listeners = new Set<() => void>()
  return {
    subscribe: (l: () => void) => {
      listeners.add(l)
      return () => { listeners.delete(l) }
    },
    get: () => state,
    set: (key: string, value: any) => {
      state = { ...state, [key]: value }
      listeners.forEach((l) => l())
    },
  }
}

const sharedStore = createSharedStore({
  isDetailOpen: initialState.isDetailOpen,
})

export function useSharedState(key: string): [any, (value: any) => void] {
  const value = useSyncExternalStore(sharedStore.subscribe, () => sharedStore.get()[key])
  const setter = (value: any) => sharedStore.set(key, value)
  return [value, setter]
}

export function setSharedState(key: string, value: any) {
  sharedStore.set(key, value)
}


