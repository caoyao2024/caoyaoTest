import React from 'react';
import Button from '@nce/eview-react/Button';
import Drawer from '@nce/eview-react/Drawer';
import styles from './styles/EventTestRoot.module.less';
import { setSharedState, useSharedState } from './shared-state';

export default function EventTestRootPage() {

  const [drawerVisibleDemoDrawer, setDrawerVisibleDemoDrawer] = useSharedState('isDetailOpen');

  return (
    <div id="eventTestRoot" className={styles.eventTestRoot}>
      <Button id="toggleBtn" text={"展开详情"} status={"primary"} onClick={() => setSharedState('isDetailOpen', true)} />
      <Drawer id="demoDrawer" onClose={() => setDrawerVisibleDemoDrawer(false)} visible={drawerVisibleDemoDrawer} placement={"right"} title={"详情抽屉"}>
        <div id="detailContent" className={styles.detailContent} />
      </Drawer>
    </div>
  )
}


