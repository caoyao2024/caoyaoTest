  --color-chart-21: var(--rose-10);
  --color-chart-22: var(--cyan-70);
  --color-chart-23: var(--yellow-20);
  --color-chart-24: var(--purple-70);
  --color-chart-25: var(--mint-20);
  /* 特殊场景 */
  --color-scrollbar: var(--gray-10);
  --color-scrollbar-hover: var(--gray-30);
  --color-card-gray-disabled: rgb(from var(--gray-30) r g b / 0.05);
  --color-card-white-disabled: rgb(from var(--gray-0) r g b / 0.5);
  --color-sidenav-bg: rgb(from var(--gray-05) r g b / 0.5);
  --color-table-header: rgb(from var(--gray-90) r g b / 0.05);
  --color-table-zebra: rgb(from var(--gray-40) r g b / 0.05);
  --color-message-bg-info: var(--blue-05);
  --color-message-bg-success: var(--mint-05);
  --color-message-bg-warning: var(--yellow-05);
  --color-message-bg-alert: var(--orange-05);
  --color-message-bg-error: var(--red-05);
 
  /* ICT3.0 3.0告警色 */
  --color-alert-urgent: #F43146;
  --color-alert-primary: #EC6F1A;
  --color-alert-secondary: #EEBA18;
  --color-alert-success: #2DA769;
  --color-alert-running: #5990FD;
  --color-alert-none: #939393;
  /* ICT3.1 表格 */
  --color-table-1: var(--brand-05);
  --color-table-2: var(--brand-10);
  --color-table-sticky-1: var(--brand-05);
  --color-table-sticky-2: var(--brand-10);
  --color-table-sticky-bg: var(--gray-0);
  --color-table-sticky-header: var(--gray-05);
  /* 标签配色 */
  --color-tag-text-purple: var(--purple-60);
  --color-tag-bg-purple: rgb(from var(--purple-10) r g b / 0.6);
  --color-tag-text-cyan: var(--cyan-80);
  --color-tag-bg-cyan: rgb(from var(--cyan-60) r g b / 0.15);
  --color-tag-text-rose: var(--rose-60);
  --color-tag-bg-rose: var(--rose-05);
  --color-tag-text-green: var(--green-70);
  --color-tag-bg-green: var(--green-10);
  --color-tag-text-pink: var(--pink-60);
  --color-tag-bg-pink: var(--pink-05);
  --color-tag-text-indigo: var(--indigo-80);
  --color-tag-bg-indigo: rgb(from var(--indigo-10) r g b / 0.6);
  --color-tag-text-none: var(--gray-70);
  --color-tag-bg-none: rgb(from var(--gray-90) r g b / 0.05);
  --color-tag-text-error: var(--red-60);
  --color-tag-bg-error: var(--red-05);
  --color-tag-text-alert: var(--orange-70);
  --color-tag-bg-alert: var(--orange-10);
  --color-tag-text-warning: var(--yellow-80);
  --color-tag-bg-warning: rgb(from var(--yellow-30) r g b / 0.6);
  --color-tag-text-success: var(--mint-70);
  --color-tag-bg-success: rgb(from var(--mint-10) r g b / 0.6);
  --color-tag-text-info: var(--blue-60);
  --color-tag-bg-info: rgb(from var(--blue-10) r g b / 0.5);


   /* Border */
   --border: var(--gray-20);
   --border-light: var(--gray-10);
   --border-primary: var(--brand-50);
   --border-success: var(--mint-20);
   --border-warning: var(--yellow-20);
   --border-alert: var(--orange-20);
   --border-error: var(--red-20);

   /* Icon */
   --icon-primary: var(--brand-50);
   --icon-success: var(--mint-50);
   --icon-warning: var(--yellow-50);
   --icon-critical: var(--orange-50);
   --icon-alert: var(--orange-50);
   --icon-error: var(--red-50);

   /* ==========================================================================
     尺寸与形状变量 (Sizes & Shapes)
     ========================================================================== */
   /* Shadow */
   --shadow-none: none;
   --shadow-sm: 0 1px 6px rgba(0, 0, 0, 0.08);
   --shadow-base: 0 4px 12px rgba(0, 0, 0, 0.16);
   --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.08);
   --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.16);
   --shadow-xl: 0 16px 48px rgba(0, 0, 0, 0.16);
   --shadow-r-sm: 1px 0 6px 0 rgba(0, 0, 0, 0.08);
   --shadow-t-sm: 0 -1px 6px rgba(0, 0, 0, 0.08);
   --shadow-l-base: -2px 0 12px 0 rgba(0, 0, 0, 0.08);
   --shadow-l-md: -2px 0 24px 0 rgba(0, 0, 0, 0.08);
}

