import initialState from '../state';
import styles from '../styles/PolicyConfigForm.module.less';

const { drfCheckboxOptions, drfCheckboxValues, drfPolicyOptions, drfSearchValue, drfSelectedPolicy, drfSelectedTableKeys, drfTableData } = initialState;

const tableColumnsDrfPolCardHighRiskTable = [
