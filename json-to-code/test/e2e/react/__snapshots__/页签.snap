// src/pages/root/modules/MasHeader.tsx
import React, { useState } from 'react';
import { IconPlusIcPublicTransverseRectangleTemplate } from '@nce/icon-plus';
import Tab, { TabItem } from '@nce/eview-react/Tab';
import initialState from '../state';
import styles from '../styles/MasHeader.module.less';

const { masAvatarImage, masLogoImage, masPlatformName, masSelectedMenuKeys, masUserName } = initialState;

const masNavItems_masHdrNavMenuEnriched = [
  {
    title: "工作台",
    key: "layout-dashboard",
    icon: <IconPlusIcPublicTransverseRectangleTemplate />
  },
  {
    title: "大屏",
    key: "monitor",
    icon: <IconPlusIcPublicTransverseRectangleTemplate />
  }
];

export default function MasHeader() {

  const [menuSelectedIndexMasHdrNavMenu, setMenuSelectedIndexMasHdrNavMenu] = useState(masSelectedMenuKeys);

  return (
    <div id="masHeaderZone" className={styles.masHeaderZone}>
      <div id="masHdrLeftSection" className={styles.masHdrLeftSection}>
        <IconPlusIcPublicTransverseRectangleTemplate id="masHdrMenuIcon" className={styles.masHdrMenuIcon} iconSize={20} type={"lined"} />
        <img id="masHdrLogoImg" src={masLogoImage} alt={"NCE-Campus Logo"} className={styles.masHdrLogoImg} />
        <span id="masHdrPlatformName" className={styles.masHdrPlatformName}>
          {masPlatformName}
        </span>
        <div id="masHdrVerticalDivider" className={styles.masHdrVerticalDivider} />
        <Tab id="masHdrNavMenu" onClick={(index) => setMenuSelectedIndexMasHdrNavMenu(index)} selectedIndex={menuSelectedIndexMasHdrNavMenu} lazyLoad={true} className={styles.masHdrNavMenu}>
          {(masNavItems_masHdrNavMenuEnriched || []).map((item, idx) => {
            const { icon, title } = item;
            return (
              <TabItem key={idx} title={title} icon={icon} />
            );
          })}
        </Tab>
      </div>
      <div id="masHdrSpacer" className={styles.masHdrSpacer} />
      <div id="masHdrRightSection" className={styles.masHdrRightSection}>
        <div id="masHdrQuickLinksGroup" className={styles.masHdrQuickLinksGroup}>
          <span id="masHdrQuickLink1" className={styles.masHdrQuickLink1}>
            {initialState.masQuickLinks[0]}
          </span>
          <span id="masHdrQuickLink2" className={styles.masHdrQuickLink2}>
            {initialState.masQuickLinks[1]}
          </span>
          <span id="masHdrQuickLink3" className={styles.masHdrQuickLink3}>
            {initialState.masQuickLinks[2]}
          </span>
          <span id="masHdrQuickLink4" className={styles.masHdrQuickLink4}>
            {initialState.masQuickLinks[3]}
          </span>
        </div>
        <div id="masHdrIconsGroup" className={styles.masHdrIconsGroup}>
          <IconPlusIcPublicTransverseRectangleTemplate id="masHdrThemeIcon" className={styles.masHdrThemeIcon} iconSize={20} type={"lined"} />
          <IconPlusIcPublicTransverseRectangleTemplate id="masHdrLangIcon" className={styles.masHdrLangIcon} iconSize={20} type={"lined"} />
          <IconPlusIcPublicTransverseRectangleTemplate id="masHdrHistoryIcon" className={styles.masHdrHistoryIcon} iconSize={20} type={"lined"} />
          <IconPlusIcPublicTransverseRectangleTemplate id="masHdrHelpIcon" className={styles.masHdrHelpIcon} iconSize={20} type={"lined"} />
          <IconPlusIcPublicTransverseRectangleTemplate id="masHdrUserIcon" className={styles.masHdrUserIcon} iconSize={20} type={"lined"} />
        </div>
        <div id="masHdrUserInfoGroup" className={styles.masHdrUserInfoGroup}>
          <span id="masHdrUserName" className={styles.masHdrUserName}>
            {masUserName}
          </span>
          <img id="masHdrAvatarImg" src={masAvatarImage} alt={"用户头像"} className={styles.masHdrAvatarImg} />
        </div>
      </div>
    </div>
  )
}


