];

export default function PolicyConfigForm() {

  const [selectValueDrfPolCardDropdownSelect, setSelectValueDrfPolCardDropdownSelect] = useState(drfSelectedPolicy);
  const [checkboxGroupValueDrfPolCardCheckboxGroup, setCheckboxGroupValueDrfPolCardCheckboxGroup] = useState(drfCheckboxValues);
  const [inputValueDrfPolCardSearchInput, setInputValueDrfPolCardSearchInput] = useState(drfSearchValue);
  const [tableCheckedRowsDrfPolCardHighRiskTable, setTableCheckedRowsDrfPolCardHighRiskTable] = useState(drfSelectedTableKeys);

  return (
    <div id="drfShellPolicyCard" className={styles.drfShellPolicyCard}>
      <div id="drfPolCardInnerWrap" className={styles.drfPolCardInnerWrap}>
        <div id="drfPolCardTitleRow" className={styles.drfPolCardTitleRow}>
          <span id="drfPolCardTitleText" className={styles.drfPolCardTitleText}>
            细则填写
          </span>
          <IconPlusIcPublicTransverseRectangleTemplate id="drfPolCardTitleHelpIcon" iconColor={["#0067D1"]} className={styles.drfPolCardTitleHelpIcon} iconSize={16} type={"lined"} />
        </div>
        <div id="drfPolCardLenientSection" className={styles.drfPolCardLenientSection}>
          <div id="drfPolCardLenientTitleRow" className={styles.drfPolCardLenientTitleRow}>
            <div id="drfPolCardLenientTitleLeft" className={styles.drfPolCardLenientTitleLeft}>
              <span id="drfPolCardLenientTitleText" className={styles.drfPolCardLenientTitleText}>
                宽松检查
              </span>
              <IconPlusIcPublicTransverseRectangleTemplate id="drfPolCardLenientHelpIcon" className={styles.drfPolCardLenientHelpIcon} iconSize={16} type={"lined"} />
            </div>
            <div id="drfPolCardLenientBtns" className={styles.drfPolCardLenientBtns}>
              <Button id="drfPolCardSelectAllBtn" leftIcon={<IconPlusIcPublicTransverseRectangleTemplate iconColor={["#0067D1"]} />} text={"一键全选"} status={"text"} onClick={(e) => {}} />
              <Button id="drfPolCardClearAllBtn" leftIcon={<IconPlusIcPublicTransverseRectangleTemplate iconColor={["#0067D1"]} />} text={"一键清除"} status={"text"} onClick={(e) => {}} />
            </div>
          </div>
          <div id="drfPolCardLenientContentBg" className={styles.drfPolCardLenientContentBg}>
            <div id="drfPolCardLenientDropdownRow" className={styles.drfPolCardLenientDropdownRow}>
              <span id="drfPolCardDropdownLabel" className={styles.drfPolCardDropdownLabel}>
                检查项间逻辑关系
              </span>
              <Select id="drfPolCardDropdownSelect" onChange={(val) => setSelectValueDrfPolCardDropdownSelect(val)} value={selectValueDrfPolCardDropdownSelect} options={drfPolicyOptions} defaultLabel={"请选择匹配策略"} selectStyle={{ width: "112px" }} />
              <span id="drfPolCardDropdownHint" className={styles.drfPolCardDropdownHint}>
                “且”指满足全部选择项，“或”指满足选择项中其中一个即可
              </span>
            </div>
            <div id="drfPolCardLenientCheckboxRow" className={styles.drfPolCardLenientCheckboxRow}>
              <span id="drfPolCardCheckboxLabel" className={styles.drfPolCardCheckboxLabel}>
                检查项
              </span>
              <CheckboxGroup id="drfPolCardCheckboxGroup" onChange={(val) => setCheckboxGroupValueDrfPolCardCheckboxGroup(val)} value={checkboxGroupValueDrfPolCardCheckboxGroup} data={drfCheckboxOptions} />
            </div>
          </div>
        </div>
        <div id="drfPolCardHighRiskSection" className={styles.drfPolCardHighRiskSection}>
          <div id="drfPolCardHighRiskTitleRow" className={styles.drfPolCardHighRiskTitleRow}>
            <span id="drfPolCardHighRiskTitleText" className={styles.drfPolCardHighRiskTitleText}>
              高危端口
            </span>
            <IconPlusIcPublicTransverseRectangleTemplate id="drfPolCardHighRiskHelpIcon" className={styles.drfPolCardHighRiskHelpIcon} iconSize={16} type={"lined"} />
          </div>
          <div id="drfPolCardHighRiskToolbar" className={styles.drfPolCardHighRiskToolbar}>
            <TextField id="drfPolCardSearchInput" onChange={(val) => setInputValueDrfPolCardSearchInput(val)} value={inputValueDrfPolCardSearchInput} placeholder={"请输入端口号"} suffix={<IconPlusIcPublicTransverseRectangleTemplate />} inputStyle={{ width: "374px" }} />
            <div id="drfPolCardToolbarBtns" className={styles.drfPolCardToolbarBtns}>
              <Button id="drfPolCardDeleteBtn" text={"删除"} onClick={(e) => {}} />
              <Button id="drfPolCardAddBtn" text={"添加"} status={"primary"} onClick={(e) => {}} />
            </div>
          </div>
          <Table id="drfPolCardHighRiskTable" dataset={drfTableData} columns={tableColumnsDrfPolCardHighRiskTable} rowKey={"id"} enablePagination={true} recordCount={drfTableData.length} checkType={"multi"} enableCheckBox={true} onRowCheck={(_, checkedRows) => setTableCheckedRowsDrfPolCardHighRiskTable(checkedRows)} checkedRows={tableCheckedRowsDrfPolCardHighRiskTable} />
        </div>
      </div>
    </div>
  )
}


