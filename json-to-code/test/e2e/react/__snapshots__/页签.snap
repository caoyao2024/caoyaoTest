import React, { useState } from 'react';
import { IconPlusIcPublicTransverseRectangleTemplate } from '@nce/icon-plus';
import Button from '@nce/eview-react/Button';
import Divider from '@nce/eview-react/Divider';
import DropDown from '@nce/eview-react/DropDown';
import Switch from '@nce/eview-react/Switch';
import Tab, { TabItem } from '@nce/eview-react/Tab';
import Table from '@nce/eview-react/Table';
import Tag from '@nce/eview-react/Tag';
import TextField from '@nce/eview-react/TextField';
import initialState from '../state';
import styles from '../styles/AuditLogTable.module.less';

const { stlActiveTabKey, stlActiveTabTabItemKey, stlCardAutoRefreshSwitchValue, stlSearchValue, stlSelectedRowKeys, stlTableItems, stlTabs, stlTabsItemTabs } = initialState;

const tableColumnsStlTable = [
  {
    key: "stationNo",
    title: "Allowed-address-pair地址",
    render: (cellValue, rowData, options, row) => {
      const { stationNo } = row.rawData;
      return (
        <a id="stlCellStationNo" href={stationNo.href} className={styles.stlCellStationNo}>
          {stationNo.text}
        </a>
      )
    },
    allowSort: false,
    width: 160
  },
  {
    key: "totalEnergy",
    title: "AAPMac地址",
    render: (cellValue, rowData, options, row) => {
      const { totalEnergy } = row.rawData;
      return (
        <span id="stlCellCustomer" className={styles.stlCellCustomer}>
          {totalEnergy}
        </span>
      )
    },
    allowSort: false,
    width: 120
  },
  {
    key: "detailInfo",
    title: "生成时间",
    render: (cellValue, rowData, options, row) => {
      const { detailInfo } = row.rawData;
      return (
        <div id="stlCellDetail" className={styles.stlCellDetail}>
          <span id="stlCellDetailLine" className={styles.stlCellDetailLine}>
            {detailInfo}
          </span>
        </div>
      )
    },
    allowSort: false,
    width: 240
  },
  {
    key: "deviceIp",
    title: "设备IP",
    render: (cellValue, rowData, options, row) => {
      const { deviceIp } = row.rawData;
      return (
        <span id="stlCellDeviceIP" className={styles.stlCellDeviceIP}>
          {deviceIp}
        </span>
      )
    },
    allowSort: false,
    width: 160
  },
  {
    key: "portId",
    title: "端口Id",
    render: (cellValue, rowData, options, row) => {
      const { portId } = row.rawData;
      return (
        <span id="stlCellPortId" className={styles.stlCellPortId}>
          {portId}
        </span>
      )
    },
    allowSort: false,
    width: 120
  },
  {
    key: "l2Vni",
    title: "L2Vni",
    render: (cellValue, rowData, options, row) => {
      const { l2Vni } = row.rawData;
      return (
        <span id="stlCellL2Vni" className={styles.stlCellL2Vni}>
          {l2Vni}
        </span>
      )
    },
    allowSort: false,
    align: "center"
  },
  {
    key: "statusTag",
    title: "状态",
    render: (cellValue, rowData, options, row) => {
      const { statusTag } = row.rawData;
      return (
        <Tag id="stlCellStatus" color={statusTag.color} fill={"outline"}>
          {statusTag.text}
        </Tag>
      )
    },
    allowSort: false,
    align: "center"
  },
  {
    key: "autoRenewal",
    title: "操作",
    render: (cellValue, rowData, options, row) => {
      const { autoRenewal } = row.rawData;
      return (
        <Switch id="stlCellRenewal" toggled={autoRenewal.checked} taggledChildren={"开"} unTaggledChildren={"关"} />
      )
    },
    allowSort: false,
    align: "center"
  }
];

export default function AuditLogTable() {

  const [tabsSelectedIndexStlTabs, setTabsSelectedIndexStlTabs] = useState(stlActiveTabKey);
  const [tabsSelectedIndexStlTabsItemTabs, setTabsSelectedIndexStlTabsItemTabs] = useState(stlActiveTabTabItemKey);
  const [inputValueStlCardSecSearchInput, setInputValueStlCardSecSearchInput] = useState(stlSearchValue);
  const [switchToggledStlCardAutoRefreshSwitch, setSwitchToggledStlCardAutoRefreshSwitch] = useState(stlCardAutoRefreshSwitchValue);
  const [tableCheckedRowsStlTable, setTableCheckedRowsStlTable] = useState(stlSelectedRowKeys);

  return (
    <div id="stlCard" className={styles.stlCard}>
      <Tab id="stlTabs" onClick={(index) => setTabsSelectedIndexStlTabs(index)} selectedIndex={tabsSelectedIndexStlTabs} className={styles.stlTabs}>
        {(stlTabs || []).map((item, idx) => {
          const { label } = item;
          return (
            <TabItem key={idx} id="stlTabItem" title={label}>
              <div id="stlTabContent" className={styles.stlTabContent}>
                <Tab id="stlTabsItemTabs" onClick={(index) => setTabsSelectedIndexStlTabsItemTabs(index)} selectedIndex={tabsSelectedIndexStlTabsItemTabs} className={styles.stlTabsItemTabs}>
                  {(stlTabsItemTabs || []).map((item, idx) => {
                    const { label } = item;
                    return (
                      <TabItem key={idx} id="stlTabsItemTabItem" title={label}>
                        <div id="stlTabItemContent" className={styles.stlTabItemContent}>
                          <div id="stlToolbarRow" className={styles.stlToolbarRow}>
                            <div id="stlCardSecToolbarLeft" className={styles.stlCardSecToolbarLeft}>
                              <TextField id="stlCardSecSearchInput" onChange={(val) => setInputValueStlCardSecSearchInput(val)} value={inputValueStlCardSecSearchInput} placeholder={"请输入搜索内容"} suffix={<IconPlusIcPublicTransverseRectangleTemplate />} inputStyle={{ width: "296px" }} />
                              <DropDown id="stlCardSecFilterDropdown" data={[{ text: "全部线索", value: "all" }, { text: "按线索类型", value: "byType" }, { text: "按线索优先级", value: "byPriority" }, { text: "按线索状态", value: "byStatus" }]} position={"left"} popupDirection={"bottom"} trigger={"click"}>
                                <div id="stlCardSecFilterTrigger" className={styles.stlCardSecFilterTrigger}>
                                  <span id="stlCardSecFilterText" className={styles.stlCardSecFilterText}>
                                    高级筛选
                                  </span>
                                  <IconPlusIcPublicTransverseRectangleTemplate id="stlCardSecFilterIcon" className={styles.stlCardSecFilterIcon} iconSize={16} type={"lined"} />
                                </div>
                              </DropDown>
                            </div>
                            <div id="stlCardSecToolbarRight" className={styles.stlCardSecToolbarRight}>
                              <div id="stlCardAutoRefresh" className={styles.stlCardAutoRefresh}>
                                <div id="stlCardAutoRefreshText" className={styles.stlCardAutoRefreshText}>
                                  自动刷新
                                </div>
                                <Switch id="stlCardAutoRefreshSwitch" onToggle={() => {}} toggled={switchToggledStlCardAutoRefreshSwitch} />
                              </div>
                              <Divider id="stlCardDivider" type={"vertical"} className={styles.stlCardDivider} />
                              <Button id="stlCardSecExportBtn" text={"导出"} onClick={(e) => {}} />
                              <Button id="stlCardSecCreateBtn" text={"创建"} status={"primary"} onClick={(e) => {}} />
                              <IconPlusIcPublicTransverseRectangleTemplate id="stlCardSecRefreshIcon" className={styles.stlCardSecRefreshIcon} iconSize={16} type={"lined"} />
                            </div>
                          </div>
                          <Table id="stlTable" dataset={stlTableItems} columns={tableColumnsStlTable} rowKey={"id"} enablePagination={true} recordCount={stlTableItems.length} checkType={"multi"} enableCheckBox={true} onRowCheck={(_, checkedRows) => setTableCheckedRowsStlTable(checkedRows)} checkedRows={tableCheckedRowsStlTable} />
                        </div>
                      </TabItem>
                    );
                  })}
                </Tab>
              </div>
            </TabItem>
          );
        })}
      </Tab>
    </div>
  )
}


// src/pages/root/modules/PolicyConfigForm.tsx
import React, { useState } from 'react';
import { IconPlusIcPublicTransverseRectangleTemplate } from '@nce/icon-plus';
import Button from '@nce/eview-react/Button';
import CheckboxGroup from '@nce/eview-react/CheckboxGroup';
