// src/styles/global.less
/* 全局样式 — 由 json-to-react 工具生成 */
* {
  margin: 0;
  padding: 0;
  border: 0 solid;
  box-sizing: border-box;
}

body {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  -webkit-font-smoothing: antialiased;
}

html {
  font-size: 16px;
}


// src/styles/hui-base-dark.css
body.theme-dark {
  /* 品牌色 */
  --color-brand: var(--brand-50);
  --color-brand-hover: var(--brand-40);
  --color-brand-focus: var(--brand-50);
  --color-brand-active: var(--brand-60);
  --color-brand-disabled: var(--brand-70);
  /* 文本色 */
  --color-text-primary: var(--gray-0);
  --color-text-secondary: var(--gray-20);
  --color-text-placeholder: var(--gray-40);
  --color-text-disabled: var(--gray-40);
  --color-text-inverse: var(--gray-0);
  --color-text-inverse-disabled: rgb(from var(--gray-05) r g b / 0.3);
  --color-text-on: var(--gray-0);
  --color-link: var(--brand-30);
  --color-link-hover: var(--brand-20);
  --color-link-active: var(--brand-40);
  --color-link-visited: var(--indigo-50);
  --color-link-disabled: var(--brand-60);
  /* 背景色 */
  --color-bg-1: var(--gray-100);
  --color-bg-2: var(--gray-90);
  --color-bg-3: var(--gray-80);
  --color-bg-4: var(--gray-70);
  --color-bg-5: rgb(from var(--gray-05) r g b / 0.1);
  --color-bg-6: rgb(from var(--gray-05) r g b / 0.1);
  --color-bg-mask: rgb(from var(--gray-0) r g b / 0.7);
  /* 填充色 */
  --color-fill-disabled: var(--gray-60);
  --color-hover: rgb(from var(--gray-05) r g b / 0.2);
  --color-fill-disabled-subtle: rgb(from var(--gray-05) r g b / 0.2);
  --color-fill: rgb(from var(--gray-05) r g b / 0.2);
  --color-select: rgb(from var(--brand-50) r g b / 0.4);
  --color-fill-subtle: rgb(from var(--gray-100) r g b / 0);

  /* 图标色 */
  --color-icon-primary: var(--gray-10);
  --color-icon-secondary: var(--gray-30);
  --color-icon-tertiary: var(--gray-50);
  --color-icon-placeholder: var(--gray-40);
  --color-icon-disabled: var(--gray-40);
  --color-icon-inverse: var(--gray-0);
  --color-icon-hover: var(--brand-20);
  --color-icon-focus: var(--brand-30);
  --color-icon-active: var(--brand-40);
  /* 边框色 */
  --color-border: var(--gray-50);
  --color-border-hover: var(--gray-05);
  --color-border-focus: var(--brand-40);
  --color-border-active: var(--brand-80);
  --color-border-disabled: var(--gray-60);
  --color-border-separator: rgb(from var(--gray-05) r g b / 0.15);
  --color-border-separator-sbutle: rgb(from var(--gray-05) r g b / 0.1);
  /* 功能色-错误 */
  --color-error: var(--red-40);
  --color-error-hover: var(--red-30);
  --color-error-active: var(--red-50);
  --color-error-disabled: var(--red-80);
  --color-error-subtle: var(--red-60);
  --color-error-subtler: var(--red-80);
  /* 功能色-告警 */
  --color-alert: var(--orange-50);
  --color-alert-hover: var(--orange-40);
  --color-alert-active: var(--orange-60);
  --color-alert-disabled: var(--orange-80);
  --color-alert-subtle: var(--orange-60);
  --color-alert-subtler: var(--orange-80);
  /* 功能色-提醒 */
  --color-warning: var(--yellow-40);
  --color-warning-hover: var(--yellow-30);
  --color-warning-active: var(--yellow-50);
  --color-warning-disabled: var(--yellow-80);
  --color-warning-bold: var(--yellow-60);
  --color-warning-subtle: var(--yellow-60);
  --color-warning-subtler: var(--yellow-80);
  /* 功能色-成功 */
  --color-success: var(--mint-60);
  --color-success-hover: var(--mint-50);
  --color-success-active: var(--mint-60);
  --color-success-disabled: var(--mint-80);
  --color-success-subtle: var(--mint-60);
  --color-success-subtler: var(--mint-80);
  /* 功能色-信息 */
  --color-info-primary: var(--blue-50);
  --color-info-primary-subtle: var(--blue-60);
  --color-info-primary-subtler: var(--blue-80);
  --color-info-secondary: var(--blue-60);
  --color-info-secondary-hover: var(--blue-40);
  --color-info-secondary-active: var(--blue-60);
  --color-info-secondary-disabled: var(--blue-80);
  --color-info-secondary-subtle: var(--blue-80);
  /* 功能色-失效 */
  --color-none: var(--gray-60);
  --color-none-hover: rgb(from var(--gray-05) r g b / 0.2);
  --color-none-active: var(--gray-50);
  --color-none-disabled: var(--gray-90);
  --color-none-subtle: var(--gray-90);
  /* 推荐图表色 */
  --color-chart-1: var(--blue-50);
  --color-chart-2: var(--green-50);
  --color-chart-3: var(--indigo-50);
  --color-chart-4: var(--cyan-50);
  --color-chart-5: var(--orange-40);
  --color-chart-6: var(--brand-30);
  --color-chart-7: var(--purple-60);
  --color-chart-8: var(--rose-60);
  --color-chart-9: var(--indigo-60);
  --color-chart-10: var(--yellow-60);
  --color-chart-11: var(--brand-60);
  --color-chart-12: var(--green-60);
  --color-chart-13: var(--purple-70);
  --color-chart-14: var(--cyan-60);
  --color-chart-15: var(--orange-70);
  --color-chart-16: var(--rose-60);
  --color-chart-17: var(--cyan-70);
  --color-chart-18: var(--blue-60);
  --color-chart-19: var(--green-70);
  --color-chart-20: var(--indigo-70);
  --color-chart-21: var(--rose-70);
  --color-chart-22: var(--cyan-30);
  --color-chart-23: var(--yellow-70);
  --color-chart-24: var(--purple-50);
  --color-chart-25: var(--mint-70);
  /* 特殊场景 */
  --color-scrollbar: var(--gray-60);
  --color-scrollbar-hover: var(--gray-40);
  --color-card-gray-disabled: rgb(from var(--gray-40) r g b / 0.05);
  --color-card-white-disabled: rgb(from var(--gray-40) r g b / 0.1);
  --color-sidenav-bg: var(--gray-70);
  --color-table-header: rgb(from var(--gray-05) r g b / 0.1);
  --color-table-zebra: rgb(from var(--gray-50) r g b / 0.15);
  --color-message-bg-info: rgb(from var(--blue-50) r g b / 0.15);
  --color-message-bg-success: rgb(from var(--mint-60) r g b / 0.15);
  --color-message-bg-warning: rgb(from var(--yellow-40) r g b / 0.15);
  --color-message-bg-alert: rgb(from var(--orange-50) r g b / 0.15);
  --color-message-bg-error: rgb(from var(--red-40) r g b / 0.15);

  /* ICT3.0 3.0告警色 */
  --color-alert-urgent: #F43146;
  --color-alert-primary: #EC6F1A;
  --color-alert-secondary: #EEBA18;
  --color-alert-success: #0D9458;
  --color-alert-running: #5990FD;
  --color-alert-none: #818181;
  /* ICT3.1 表格 */
  --color-table-1: rgb(from var(--brand-50) r g b / 0.2);
  --color-table-2: rgb(from var(--brand-50) r g b / 0.4);
  --color-table-sticky-1: var(--brand-80);
  --color-table-sticky-2: var(--brand-70);
  --color-table-sticky-bg: var(--gray-70);
  --color-table-sticky-header: var(--gray-70);
  /* 标签配色 */
  --color-tag-text-purple: var(--purple-30);
  --color-tag-bg-purple: rgb(from var(--purple-30) r g b / 0.15);
  --color-tag-text-cyan: var(--cyan-40);
  --color-tag-bg-cyan: rgb(from var(--cyan-50) r g b / 0.15);
  --color-tag-text-rose: var(--rose-30);
  --color-tag-bg-rose: rgb(from var(--rose-30) r g b / 0.15);
  --color-tag-text-green: var(--green-50);
  --color-tag-bg-green: rgb(from var(--green-40) r g b / 0.15);
  --color-tag-text-pink: var(--pink-30);
  --color-tag-bg-pink: rgb(from var(--pink-30) r g b / 0.15);
  --color-tag-text-indigo: var(--indigo-30);
  --color-tag-bg-indigo: rgb(from var(--indigo-30) r g b / 0.15);
  --color-tag-text-none: var(--gray-30);
  --color-tag-bg-none: rgb(from var(--gray-30) r g b / 0.15);
  --color-tag-text-error: var(--red-40);
  --color-tag-bg-error: rgb(from var(--red-30) r g b / 0.15);
  --color-tag-text-alert: var(--orange-40);
  --color-tag-bg-alert: rgb(from var(--orange-50) r g b / 0.15);
  --color-tag-text-warning: var(--yellow-50);
  --color-tag-bg-warning: rgb(from var(--yellow-30) r g b / 0.15);
  --color-tag-text-success: var(--mint-40);
  --color-tag-bg-success: rgb(from var(--mint-50) r g b / 0.15);
  --color-tag-text-info: var(--blue-30);
  --color-tag-bg-info: rgb(from var(--blue-40) r g b / 0.15);

  /* Border */
  --border: var(--gray-50);
  --border-light: rgb(from var(--gray-05) r g b / 0.15);
  --border-primary: var(--brand-30);
  --border-success: var(--mint-20);
  --border-warning: var(--yellow-20);
  --border-alert: var(--orange-20);
  --border-error: var(--red-20);

  /* Icon */
  --icon-primary: var(--brand-30);
  --icon-success: var(--mint-30);
  --icon-warning: var(--yellow-30);
  --icon-critical: var(--orange-30);
  --icon-alert: var(--orange-30);
  --icon-error: var(--red-30);


  /* Shadow (暗色模式下阴影更强) */
  --shadow-none: none;
  --shadow-sm: 0 1px 6px rgba(0, 0, 0, 0.5);
  --shadow-base: 0 4px 12px rgba(0, 0, 0, 0.5);
  --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.5);
  --shadow-lg: 0 8px 24px rgba(0, 0, 0, 0.5);
  --shadow-xl: 0 16px 48px rgba(0, 0, 0, 0.5);
  --shadow-r-sm: 1px 0 6px 0 rgba(0, 0, 0, 0.5);
  --shadow-t-sm: 0 -1px 6px rgba(0, 0, 0, 0.5);
  --shadow-l-base: -2px 0 12px 0 rgba(0, 0, 0, 0.5);
  --shadow-l-md: -2px 0 24px 0 rgba(0, 0, 0, 0.5);


  /* ==========================================================================
  eview react 样式覆盖
  ========================================================================== */

  color: var(--color-text-primary);

  .ev_tag.default {
    color: var(--gray-30) !important;
    background: rgb(from var(--gray-30) r g b / 0.15) !important;
    border-color: transparent !important;
  }

  /* tag solid */
  .ev_tag.info,
  .aui3_1_dark .ev_tag.info {
    color: var(--gray-0) !important;
    background: var(--blue-50) !important;
    border-color: transparent;
  }

  .ev_tag.error,
  .aui3_1_dark .ev_tag.error {
    color: var(--gray-0);
    background: var(--red-50);
    border-color: transparent;
  }

  .ev_tag.alert,
  .aui3_1_dark .ev_tag.alert {
    color: var(--gray-0);
    background: var(--orange-50);
    border-color: transparent;
  }

  .ev_tag.warning,
  .aui3_1_dark .ev_tag.warning {
    color: var(--gray-0);
    background: var(--yellow-50);
    border-color: transparent;
  }

  .ev_tag.success,
  .aui3_1_dark .ev_tag.success {
    color: var(--gray-0);
    background: var(--mint-50);
    border-color: transparent;
  }

  .ev_tag.disabled,
  .aui3_1_dark .ev_tag.disabled {
    color: var(--gray-0);
    background: var(--gray-30);
    border-color: transparent;
  }

  /* fill */
  .ev_tag.info.ev_tag_fill {
    color: var(--brand-30) !important;
    background: rgb(from var(--brand-30) r g b / 0.15) !important;
    border-color: transparent !important;
  }

  .ev_tag.error.ev_tag_fill {
    color: var(--red-40) !important;
    background: rgb(from var(--red-30) r g b / 0.15) !important;
    border-color: transparent !important;
  }

  .ev_tag.alert.ev_tag_fill {
    color: var(--orange-40) !important;
    background: rgb(from var(--orange-50) r g b / 0.15) !important;
    border-color: transparent !important;
  }

  .ev_tag.warning.ev_tag_fill {
    color: var(--yellow-50) !important;
    background: rgb(from var(--yellow-30) r g b / 0.15) !important;
    border-color: transparent !important;
  }

  .ev_tag.success.ev_tag_fill {
    color: var(--mint-40) !important;
    background: rgb(from var(--mint-50) r g b / 0.15) !important;
    border-color: transparent !important;
  }

  .ev_tag.disabled.ev_tag_fill {
    color: var(--gray-30) !important;
    background: rgb(from var(--gray-30) r g b / 0.15) !important;
    border-color: transparent !important;
  }

  .ev_tag.green {
    color: var(--mint-40) !important;
    background: rgb(from var(--green-40) r g b / 0.15) !important;
    border-color: transparent !important;
  }

  .ev_tag.rose {
    color: var(--rose-30) !important;
    background: rgb(from var(--rose-30) r g b / 0.15) !important;
    border-color: transparent !important;
  }

  .ev_tag.pink {
    color: var(--pink-30) !important;
    background: rgb(from var(--pink-30) r g b / 0.15) !important;
    border-color: transparent !important;
  }

  .ev_tag.purple {
    color: var(--purple-30) !important;
    background: rgb(from var(--purple-30) r g b / 0.15) !important;
    border-color: transparent !important;
  }

  .ev_tag.indigo {
    color: var(--indigo-30) !important;
    background: rgb(from var(--indigo-30) r g b / 0.15) !important;
    border-color: transparent !important;
  }

  .ev_tag.cyan {
    color: var(--cyan-40) !important;
    background: rgb(from var(--cyan-50) r g b / 0.15) !important;
    border-color: transparent !important;
  }
}

// src/styles/hui-base.css
:root {
  /* 品牌色 */
  --color-brand: var(--brand-50);
  --color-brand-hover: var(--brand-40);
  --color-brand-focus: var(--brand-50);
  --color-brand-active: var(--brand-60);
  --color-brand-disabled: var(--brand-20);
  /* 文本色 */
  --color-text-primary: var(--gray-90);
  --color-text-secondary: var(--gray-50);
  --color-text-placeholder: var(--gray-30);
  --color-text-disabled: var(--gray-20);
  --color-text-inverse: var(--gray-0);
  --color-text-inverse-disabled: var(--gray-0);
  --color-text-on: var(--brand-50);
  --color-link: var(--brand-50);
  --color-link-hover: var(--brand-40);
  --color-link-active: var(--brand-60);
  --color-link-visited: var(--indigo-50);
  --color-link-disabled: var(--brand-20);
  /* 背景色 */
  --color-bg-1: var(--gray-05);
  --color-bg-2: var(--gray-0);
  --color-bg-3: var(--gray-0);
  --color-bg-4: var(--gray-0);
  --color-bg-5: var(--gray-0);
  --color-bg-6: rgb(from var(--gray-20) r g b / 0.2);
  --color-bg-mask: rgb(from var(--gray-90) r g b / 0.3);
  /* 填充色 */
  --color-fill-disabled: var(--gray-10);
  --color-hover: rgb(from var(--gray-90) r g b / 0.05);
  --color-fill-disabled-subtle: rgb(from var(--gray-90) r g b / 0.05);
  --color-fill: rgb(from var(--gray-90) r g b / 0.05);
  --color-select: var(--brand-05);
  --color-fill-subtle: var(--gray-0);

  /* 图标色 */
  --color-icon-primary: var(--gray-90);
  --color-icon-secondary: var(--gray-50);
  --color-icon-tertiary: var(--gray-40);
  --color-icon-placeholder: var(--gray-30);
  --color-icon-disabled: var(--gray-20);
  --color-icon-inverse: var(--gray-0);
  --color-icon-hover: var(--brand-40);
  --color-icon-focus: var(--brand-50);
  --color-icon-active: var(--brand-60);
  /* 边框色 */
  --color-border: var(--gray-20);
  --color-border-hover: var(--gray-90);
  --color-border-focus: var(--brand-50);
  --color-border-active: var(--brand-10);
  --color-border-disabled: var(--gray-20);
  --color-border-separator: var(--gray-10);
  --color-border-separator-sbutle: var(--gray-05);
  /* 功能色-错误 */
  --color-error: var(--red-50);
  --color-error-hover: var(--red-40);
  --color-error-active: var(--red-60);
  --color-error-disabled: var(--red-10);
  --color-error-subtle: var(--red-20);
  --color-error-subtler: var(--red-05);
  /* 功能色-告警 */
  --color-alert: var(--orange-50);
  --color-alert-hover: var(--orange-40);
  --color-alert-active: var(--orange-60);
  --color-alert-disabled: var(--orange-10);
  --color-alert-subtle: var(--orange-20);
  --color-alert-subtler: var(--orange-05);
  /* 功能色-提醒 */
  --color-warning: var(--yellow-50);
  --color-warning-hover: var(--yellow-40);
  --color-warning-active: var(--yellow-60);
  --color-warning-disabled: var(--yellow-10);
  --color-warning-bold: var(--yellow-60);
  --color-warning-subtle: var(--yellow-20);
  --color-warning-subtler: var(--yellow-05);
  /* 功能色-成功 */
  --color-success: var(--mint-50);
  --color-success-hover: var(--mint-40);
  --color-success-active: var(--mint-60);
  --color-success-disabled: var(--mint-10);
  --color-success-subtle: var(--mint-20);
  --color-success-subtler: var(--mint-05);
  /* 功能色-信息 */
  --color-info-primary: var(--blue-50);
  --color-info-primary-subtle: var(--blue-30);
  --color-info-primary-subtler: var(--blue-05);
  --color-info-secondary: var(--blue-30);
  --color-info-secondary-hover: var(--blue-20);
  --color-info-secondary-active: var(--blue-40);
  --color-info-secondary-disabled: var(--blue-10);
  --color-info-secondary-subtle: var(--blue-05);
  /* 功能色-失效 */
  --color-none: var(--gray-30);
  --color-none-hover: var(--gray-20);
  --color-none-active: var(--gray-40);
  --color-none-disabled: var(--gray-10);
  --color-none-subtle: var(--gray-05);
  /* 推荐图表色 */
  --color-chart-1: var(--blue-50);
  --color-chart-2: var(--green-50);
  --color-chart-3: var(--indigo-50);
  --color-chart-4: var(--cyan-50);
  --color-chart-5: var(--orange-40);
  --color-chart-6: var(--brand-30);
  --color-chart-7: var(--purple-40);
  --color-chart-8: var(--rose-40);
  --color-chart-9: var(--indigo-20);
  --color-chart-10: var(--yellow-60);
  --color-chart-11: var(--brand-10);
  --color-chart-12: var(--green-60);
  --color-chart-13: var(--purple-20);
  --color-chart-14: var(--cyan-60);
  --color-chart-15: var(--orange-20);
  --color-chart-16: var(--rose-60);
  --color-chart-17: var(--cyan-20);
  --color-chart-18: var(--blue-60);
  --color-chart-19: var(--green-20);
