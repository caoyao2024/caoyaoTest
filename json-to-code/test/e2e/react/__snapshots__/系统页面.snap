const tableColumnsSysManageWorkorderTable = [
  {
    key: "subsystem",
    title: "子系统",
    render: (cellValue, rowData, options, row) => {
      const { subsystem } = row.rawData;
      return (
        <span id="sysManageSubsystemCell" className={styles.sysManageSubsystemCell}>
          {subsystem}
        </span>
      )
    },
    allowSort: false,
    width: 60
  },
  {
    key: "status",
    title: "状态",
    render: (cellValue, rowData, options, row) => {
      const { status } = row.rawData;
      return (
        <Tag id="sysManageStatusCell" color={status.color} size={"small"} fill={"outline"}>
          {status.text}
        </Tag>
      )
    },
    allowSort: false,
    width: 50
  },
  {
    key: "configuration",
    title: "配置",
    render: (cellValue, rowData, options, row) => {
      const { configuration } = row.rawData;
      return (
        <div id="sysManageConfigurationCell" className={styles.sysManageConfigurationCell}>
          {configuration}
        </div>
      )
    },
    allowSort: false,
    width: 180
  },
  {
    key: "configurationValue",
    title: "配置项值",
    render: (cellValue, rowData, options, row) => {
      const { configurationValue } = row.rawData;
      return (
        <div id="sysManageConfigurationValueCell" className={styles.sysManageConfigurationValueCell}>
          {configurationValue}
        </div>
      )
    },
    allowSort: false,
    width: 60
  },
  {
    key: "defaultVal",
    title: "默认值",
    render: (cellValue, rowData, options, row) => {
      const { defaultVal } = row.rawData;
      return (
        <span id="sysManageDefaultValCell" className={styles.sysManageDefaultValCell}>
          {defaultVal}
        </span>
      )
    },
    allowSort: false,
    width: 50
  },
  {
    key: "describe",
    title: "描述",
    render: (cellValue, rowData, options, row) => {
      const { describe } = row.rawData;
      return (
        <span id="sysManageDescribeCell">
          {describe}
        </span>
      )
    },
    allowSort: false,
    width: 260
  },
  {
    key: "microservice",
    title: "重启微服务",
    render: (cellValue, rowData, options, row) => {
      const { microservice } = row.rawData;
      return (
        <span id="sysManageMicroserviceCell">
          {microservice}
        </span>
      )
    },
    allowSort: false,
    width: 50
  },
  {
    key: "actions",
    title: "操作",
    render: (cellValue, rowData, options, row) => {
      const { actions } = row.rawData;
      return (
        <div id="sysManageActionsCell" className={styles.sysManageActionsCell}>
          {(actions || []).map((item, idx) => {
            const { icon } = item;
            return (
              <IconButton key={idx} id="sysManageActionButton" iconName={icon} onClick={(e) => {}} />
            );
          })}
        </div>
      )
    },
    allowSort: false,
    width: 50
  }
];

export default function SystemSettings() {

  const [inputValueSysManageSearchInput, setInputValueSysManageSearchInput] = useState(twoSearchValue);
  const [switchToggledTwoCardAutoRefreshSwitch, setSwitchToggledTwoCardAutoRefreshSwitch] = useState(twoCardAutoRefreshSwitchValue);

  return (
    <div id="sysManageCardContainer" className={styles.sysManageCardContainer}>
      <div id="sysManageInner" className={styles.sysManageInner}>
        <span id="sysManageTitle" className={styles.sysManageTitle}>
          系统规格管理
        </span>
        <div id="sysManageToolbarRow" className={styles.sysManageToolbarRow}>
          <div id="sysManageToolbarLeft" className={styles.sysManageToolbarLeft}>
            <TextField id="sysManageSearchInput" onChange={(val) => setInputValueSysManageSearchInput(val)} value={inputValueSysManageSearchInput} placeholder={"请输入搜索内容"} suffix={<IconPlusIcPublicTransverseRectangleTemplate />} inputStyle={{ width: "296px" }} />
            <DropDown id="sysManageFilterDropdown" data={[{ text: "全部线索", value: "all" }, { text: "按线索类型", value: "byType" }, { text: "按线索优先级", value: "byPriority" }, { text: "按线索状态", value: "byStatus" }]} position={"left"} popupDirection={"bottom"} trigger={"click"}>
              <div id="sysManageFilterTrigger" className={styles.sysManageFilterTrigger}>
                <span id="sysManageFilterText" className={styles.sysManageFilterText}>
                  高级筛选
                </span>
                <IconPlusIcPublicTransverseRectangleTemplate id="sysManageFilterIcon" className={styles.sysManageFilterIcon} iconSize={16} type={"lined"} />
              </div>
            </DropDown>
          </div>
          <div id="sysManageToolbarRight" className={styles.sysManageToolbarRight}>
            <div id="twoCardAutoRefresh" className={styles.twoCardAutoRefresh}>
              <div id="twoCardAutoRefreshText" className={styles.twoCardAutoRefreshText}>
                自动刷新
              </div>
              <Switch id="twoCardAutoRefreshSwitch" onToggle={() => {}} toggled={switchToggledTwoCardAutoRefreshSwitch} />
            </div>
            <Divider id="twoCardDivider" type={"vertical"} className={styles.twoCardDivider} />
            <Button id="sysManageExportBtn" text={"导出"} onClick={(e) => {}} />
            <Button id="sysManageCreateBtn" text={"创建"} status={"primary"} onClick={(e) => {}} />
            <IconPlusIcPublicTransverseRectangleTemplate id="sysManageRefreshIcon" className={styles.sysManageRefreshIcon} iconSize={16} type={"lined"} />
          </div>
        </div>
        <Table id="sysManageWorkorderTable" dataset={twoWorkorderList} columns={tableColumnsSysManageWorkorderTable} rowKey={"key"} enablePagination={true} recordCount={twoWorkorderList.length} className={styles.sysManageWorkorderTable} />
      </div>
    </div>
  )
}


